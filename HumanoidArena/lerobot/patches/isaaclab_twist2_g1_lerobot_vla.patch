+#!/usr/bin/env bash
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+LEROBOT_ROOT="${LEROBOT_ROOT:-${SCRIPT_DIR}/../lerobot}"
+LEROBOT_POLICY_PATH="${LEROBOT_POLICY_PATH:-}"
+LEROBOT_POLICY_DEVICE="${LEROBOT_POLICY_DEVICE:-cuda:0}"
+TWIST2_MODEL_PATH="${TWIST2_MODEL_PATH:-${SCRIPT_DIR}/../TWIST2/assets/ckpts/twist2_1017_20k.onnx}"
+TASK_NAME="${TASK_NAME:-Isaac-Move-Football-G129-Dex3-Wholebody}"
+ENV_CONFIG_YAML="${ENV_CONFIG_YAML:-tasks/common_env_config/twist2_default.yaml}"
+
+if [[ -z "${LEROBOT_POLICY_PATH}" ]]; then
+  echo "LEROBOT_POLICY_PATH is required"
+  echo "Example:"
+  echo "  LEROBOT_POLICY_PATH=/abs/path/to/checkpoints/last/pretrained_model bash run_vla.sh"
+  exit 1
+fi
+
+export PYTHONPATH="${LEROBOT_ROOT}/src:${PYTHONPATH:-}"
+
+cd "${SCRIPT_DIR}"
+python sim_main.py \
+  --input_source vla \
+  --gmt_backend twist2 \
+  --env_config_yaml "${ENV_CONFIG_YAML}" \
+  --task "${TASK_NAME}" \
+  --robot_type g129 \
+  --model_path "${TWIST2_MODEL_PATH}" \
+  --lerobot_policy_path "${LEROBOT_POLICY_PATH}" \
+  --lerobot_policy_device "${LEROBOT_POLICY_DEVICE}" \
+  "$@"
